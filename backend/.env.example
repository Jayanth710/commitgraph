APP_NAME=CommitGraph API
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://commitgraph:commitgraph@localhost:5432/commitgraph
DATABASE_URL_SYNC=postgresql://commitgraph:commitgraph@localhost:5432/commitgraph

REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-in-real-env
ENCRYPTION_KEY=change-me-later

# Production secret handling: point SECRETS_DIR at a directory of secret files
# (e.g. a Google Secret Manager volume mounted on Cloud Run). Each file is named
# after a setting (secret_key, jwt_secret, ...) and overrides the env var, so
# secrets never live in plaintext env. Leave unset for local dev.
SECRETS_DIR=

# Gmail OAuth (per account — we'll start with one)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GCP Pub/Sub
GCP_PROJECT_ID=
GCP_PUBSUB_TOPIC=commitgraph-gmail
GCP_SERVICE_ACCOUNT_KEY_PATH=

# Webhook authentication (REQUIRED in production)
# Service account email Google signs Pub/Sub push OIDC tokens with.
PUBSUB_VERIFICATION_EMAIL=
# Audience set on the Pub/Sub push subscription (usually the webhook URL).
PUBSUB_AUDIENCE=
# High-entropy secret echoed back in Outlook Graph notifications.
OUTLOOK_CLIENT_STATE=

# Microsoft OAuth (later)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# Slack (connected source). Create an app at api.slack.com/apps.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/auth/slack/callback

# LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# LiteLLM
LITELLM_DAILY_BUDGET_USD=2.00

# Observability (optional; disabled until set)
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Encryption
TOKEN_ENCRYPTION_KEY=  # 32-byte key for AES-256-GCM

# App
APP_ENV=development
API_PORT=8000
WEB_PORT=3000
MCP_PORT=3001
```